# Anthropic API key for the LLM orchestrator
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model override (defaults to claude-opus-4-5)
ANTHROPIC_MODEL=claude-opus-4-5

# LangSmith observability
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true

# Optional dev-mode controls (skip/cutoff steps during local testing)
# DEV_MODE_ENABLED=true
# DEV_MODE_SKIP_STEPS=STEP_04,STEP_05
# DEV_MODE_CUTOFF_STEP=STEP_02

# ============================================
# AWS Deployment (only needed for AWS hosting)
# ============================================

# API authentication (clients send as x-api-key header)
# Auto-generated by ./infra/deploy.sh if empty: openssl rand -hex 32
API_KEY=

# Stage-specific LangSmith projects
# Auto-generated if empty: sbiq-conditions-ai-dev / sbiq-conditions-ai-prod
LANGSMITH_DEV_PROJECT=
LANGSMITH_PROD_PROJECT=

# CORS origins (comma-separated)
# Auto-generated if empty: *
CORS_ALLOW_ORIGINS=

# Optional AWS target overrides (defaults match Fintor account / us-east-2)
# SBIQ_AWS_ACCOUNT_ID=828351637694
# SBIQ_AWS_REGION=us-east-2
